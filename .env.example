# 변수 이름만 적는다. 실제 값은 .env(커밋 안 함)·배포 환경변수·GitHub Secrets에 직접 넣는다.

# 서비스용 AI 키(필요할 때만). 학생이 대시보드 자료 → API 키에서 발급해 직접 설정
AI_GATEWAY_API_KEY=

# DB 접속 주소. docker는 docker-compose.yml에 이미 있음. 로컬 npm run dev나 배포 환경에서만 설정
DATABASE_URL=

# FE 개발용 목업(BE 연동 전). true면 /api/guides 대신 components/guide/mock.ts 응답을 씀. main·배포에서는 비워 둔다
NEXT_PUBLIC_USE_MOCK=
